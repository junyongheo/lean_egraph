mutual

def repair (id : EClassId) [Analysis α D] : EGraphM α D (Unit) := do

  let canonId ← lookupCanonicalEClassId id
  let eg ← get
  /-
  match eg.ecmap.lookup canonId with
  | some _ => pure () -- no op it exists go on
  | none   => return () -- don't panic all is well
  -/ -- made redundant by the next line?

  let some eClass := eg.ecmap.lookup canonId | return () -- panic!"lookup on canon shouldn't fail (Naive.lean line 346)"-- make this better..

  -- Loop 1...
  let (updateHCons, collisions) ← eClass.parents.foldlM (init := (eg.hcons, [])) (λ (hcons', collisions') (p : (ENode α × EClassId)) => do
      let canon ← canonicalise p.1
      let canonId ← lookupCanonicalEClassId p.2
      let det := hcons'.filter (λ hc => hc.1 ≠ p.1)
      match det.lookup canon with
      | some key => return (det, (canonId, key) :: collisions') -- keeps track of things to merge without collisions
      | none     => return ((canon, canonId) :: det, collisions')
  )

  let eg ← get
  let _ ← set { eg with hcons := updateHCons }
/-
  for (id₁, id₂) in collisions do
    let _ ← union id₁ id₂ (Analysis.join (α := α) (D := D))

  let curNodes ← eClass.nodes.mapM canonicalise
  let _newNodes := curNodes.eraseDups
-/

  -- Loop 2...
  let (_, pc) ← eClass.parents.foldlM (init := ([], [])) (λ (seen, pc) (p : (ENode α × EClassId)) => do
    let canon ← canonicalise p.1
    let canonId ← lookupCanonicalEClassId p.2
    match seen.lookup canon with
    | some eid => return (seen, (eid, canonId) :: pc)
    | none     => return ((canon, canonId) :: seen, pc)
  )

  let allColls := collisions ++ pc
  for coll in allColls do
    let _ ← union coll.1 coll.2

  let eg' ← get
  let canonId' ←  (lookupCanonicalEClassId canonId)
  let some eClassFinal := eg'.ecmap.lookup canonId' | panic!"should "

  let newNodes' ← eClassFinal.nodes.foldlM (init := []) (λ acc n => do
    let thenew ← canonicalise n
    if acc.any (λ alr => alr == thenew) then return acc else return thenew :: acc
  )

  let newParents' ← eClassFinal.parents.foldlM (init := []) (λ acc (en, eid) => do
    let cen ← canonicalise en
    let cid ← lookupCanonicalEClassId eid
    if acc.any (λ (nod, theid) => nod == cen && theid == cid) then
      return acc
    else
      return (cen, cid) :: acc
  )

  let _ ← set
    { eg' with
      ecmap :=
        (canonId', { eClassFinal with parents := newParents', nodes := newNodes' })
          :: eg'.ecmap.filter (λ c => c.1 ≠ canonId')
    } -- TODO: make style more readable later...

def repairHegg (id : EClassId) (en : ENode α) [Analysis α D] : EGraphM α D <| Unit := do
  let eg ← get
  match eg.hcons.lookup en with
  | none =>
    let _ ← set {eg with hcons := (en, id) :: eg.hcons.filter (λ a => a.1 ≠ en)}
  | some existing =>
    let _ ← set {eg with hcons := (en, id) :: eg.hcons.filter (λ a => a.1 ≠ en)}
    let _ ← union existing id


def union (id₁ id₂ : EClassId) [Analysis α D] : EGraphM α D (EClassId) := do

  -- Get canonical classes for the inputs
  let id₁' ← lookupCanonicalEClassId id₁
  let id₂' ← lookupCanonicalEClassId id₂
  -- In same class, nothing more to do
  if id₁' = id₂' then
    return id₁'
  -- In different class, we do work
  else
    -- moved this here for less operations?
    let eg ← get
    -- Update union find
    let uf' := eg.uf.union! id₁' id₂'
    let (uf''', leaderClassId) := uf'.find! id₁'
    -- more path compression........?
    let (uf'',  _) := uf'''.find! id₂'
    -- Update EClass, EClassMap and Hashcons with new UF canonies
    let fromId := if id₁' = leaderClassId then id₂' else id₁'
    -- merge std hashmap union
    -- also touch parents -- not in egg style deferred
    let lCls := (eg.ecmap.lookup leaderClassId).getD EClass.empty
    let sCls := (eg.ecmap.lookup fromId).getD EClass.empty
    let mergedClass := EClass.merge lCls sCls (Analysis.join (α := α) (D := D))

    let newEcmap := (leaderClassId, mergedClass) :: eg.ecmap.filter (λ (id, _) => id ≠ fromId && id ≠ leaderClassId)

    let _ ← set {
                  eg with
                  uf := uf''
                  ecmap := newEcmap
                }

    repair leaderClassId
    repairAnalysis leaderClassId
    return leaderClassId

end